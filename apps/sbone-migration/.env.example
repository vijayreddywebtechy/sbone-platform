# Micro frontend (multi-zone) addresses for this environment. Override per environment (e.g. ECS task env vars);
# they are read at runtime by proxy.ts, so no rebuild is needed when they change.

# Beneficiary Management (apps/sbone-beneficiary-management), served under /beneficiaries
BENEFICIARY_APP_URL=http://localhost:3010

# Optional: Ping registration for "Enroll to SBOne" (leave empty to go straight to identity verification)
PING_REGISTRATION_URL=
NEXT_PUBLIC_PING_REGISTRATION_URL=
