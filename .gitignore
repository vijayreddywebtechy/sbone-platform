# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are unanchored so they apply inside every workspace (apps/*, packages/*).

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Templates listing each app's variables are committed; real values stay local / in the deploy config
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
